{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": "notify",
  "agent": {
    "build": {
      "model": "openai/gpt-6-astra",
      "variant": "high",
      "permission": {
        "playwright_*": "allow",
        "playwright_browser_evaluate": "ask",
        "playwright_browser_run_code_unsafe": "deny",
        "zai-mcp-server_*": "allow"
      }
    },
    "explore": {
      "model": "openai/gpt-5.6-terra",
      "variant": "medium"
    },
    "general": {
      "model": "openai/gpt-6-astra",
      "variant": "high"
    },
    "plan": {
      "model": "openai/gpt-6-astra",
      "variant": "high"
    }
  },
  "compaction": {
    "auto": true,
    "prune": true
  },
  "default_agent": "orchestrator",
  "formatter": {
    "dartfmt": {
      "command": ["dart", "format", "$FILE"],
      "extensions": [".dart"]
    },
    "eslint": {
      "command": ["npx", "eslint", "--fix", "$FILE"],
      "extensions": [
        ".js",
        ".jsx",
        ".ts",
        ".tsx",
        ".mjs",
        ".cjs",
        ".mts",
        ".cts"
      ]
    },
    "gofmt": {
      "command": ["gofmt", "-w", "$FILE"],
      "extensions": [".go"]
    },
    "prettier": {
      "command": ["npx", "prettier", "--write", "$FILE"],
      "extensions": [".json", ".md", ".yml", ".yaml", ".css", ".scss"]
    },
    "rubocop": {
      "command": ["bundle", "exec", "rubocop", "-a", "$FILE"],
      "extensions": [".rb", ".rake", ".gemspec", ".ru"]
    },
    "ruff": {
      "command": [
        "bash",
        "-lc",
        "ruff check --fix \"$FILE\" && ruff format \"$FILE\""
      ],
      "extensions": [".py", ".pyi"]
    },
    "rustfmt": {
      "command": ["rustfmt", "$FILE"],
      "extensions": [".rs"]
    }
  },
  "instructions": [
    "instructions/core.md",
    "instructions/documentation.md",
    "instructions/testing.md",
    "instructions/security.md",
    "instructions/git.md",
    "instructions/api.md",
    "instructions/database.md",
    "instructions/shell.md"
  ],
  "mcp": {
    "context7": {
      "enabled": true,
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },
    "gh_grep": {
      "enabled": true,
      "type": "remote",
      "url": "https://mcp.grep.app"
    },
    "playwright": {
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@0.0.80",
        "--browser=chromium",
        "--caps=core,vision,pdf,testing",
        "--output-dir=./browser-outputs",
        "--viewport-size=1920x1080",
        "--timeout-action=10000"
      ],
      "enabled": true,
      "type": "local"
    },
    "sentry": {
      "enabled": false,
      "oauth": {},
      "type": "remote",
      "url": "https://mcp.sentry.dev/mcp"
    },
    "zai-mcp-server": {
      "command": ["npx", "-y", "@z_ai/mcp-server@0.1.5"],
      "enabled": true,
      "environment": {
        "Z_AI_API_KEY": "{file:~/.config/opencode/.env.zai-api-key}",
        "Z_AI_MODE": "ZAI"
      },
      "type": "local"
    }
  },
  "model": "openai/gpt-6-astra",
  "permission": {
    "bash": {
      "*": "ask",
      "pwd": "allow",
      "git status": "allow",
      "git status *": "allow",
      "git diff": "allow",
      "git diff *": "allow",
      "git log": "allow",
      "git log *": "allow",
      "git show": "allow",
      "git show *": "allow",
      "git *--output*": "ask",
      "git *--ext-diff*": "ask",
      "git *--textconv*": "ask",
      "chmod *": "ask",
      "chown *": "ask",
      "curl *": "ask",
      "dd *": "ask",
      "git clean *": "ask",
      "git commit*": "ask",
      "git push*": "ask",
      "git rebase*": "ask",
      "git reset*": "ask",
      "mv *": "ask",
      "rm *": "ask",
      "sudo *": "ask",
      "wget *": "ask"
    },
    "doom_loop": "ask",
    "edit": {
      "*": "allow",
      "**/.aws/**": "deny",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "**/.ssh/**": "deny",
      "**/secrets/**": "deny",
      "**/opencode/service.json": "deny"
    },
    "external_directory": {
      "*": "ask",
      "~/.agent-configs": "allow",
      "~/.agent-configs/**": "allow",
      "~/.claude/CLAUDE.md": "allow",
      "~/.claude/commands/**": "allow",
      "~/.claude/skills/**": "allow",
      "~/.agents/skills/**": "allow",
      "~/.codex/AGENTS.md": "allow",
      "~/.config/kilo/AGENTS.md": "allow",
      "~/.config/kilo/commands/**": "allow",
      "~/.config/kilo/instructions/**": "allow",
      "~/.config/kilo/skills/**": "allow",
      "~/Pictures/Screenshots": "allow",
      "~/Pictures/Screenshots/*": "allow"
    },
    "read": {
      "*": "allow",
      "**/*credential*": "deny",
      "**/*credentials*": "deny",
      "**/*private_key*": "deny",
      "**/*token*": "deny",
      "**/.aws/**": "deny",
      "**/.netrc": "deny",
      "**/.npmrc": "deny",
      "**/.pypirc": "deny",
      "**/.ssh/**": "deny",
      "**/secrets/**": "deny",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.pem": "deny",
      "**/opencode/service.json": "deny"
    },
    "playwright_*": "deny",
    "playwright_browser_run_code_unsafe": "deny",
    "zai-mcp-server_*": "deny",
    "skill": {
      "*": "allow"
    },
    "task": {
      "*": "deny"
    }
  },
  "plugin": [
    "@ex-machina/opencode-anthropic-auth@1.8.1",
    "@nick-vi/opencode-type-inject@1.5.2",
    "opencode-mem@2.23.0"
  ],
  "share": "manual",
  "shell": "zsh",
  "subagent_depth": 1,
  "watcher": {
    "ignore": [
      "**/.git/**",
      "**/.next/**",
      "**/dist/**",
      "**/build/**",
      "**/coverage/**",
      "**/node_modules/**",
      "**/vendor/**",
      "**/.turbo/**",
      "**/.pytest_cache/**",
      "**/__pycache__/**",
      "**/*.pyc",
      "**/target/**",
      "**/.dart_tool/**",
      "**/ios/Pods/**",
      "**/ios/build/**",
      "**/ios/DerivedData/**",
      "**/android/.gradle/**",
      "**/android/build/**",
      "**/android/app/build/**"
    ]
  }
}
